{
  "name": "frameboard",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source workspace for product teams to run RICE, ICE, MoSCoW, and Kano prioritization.",
  "license": "MIT",
  "author": "James (james-kanghj)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "dev:web": "pnpm --filter @frameboard/web dev",
    "dev:api": "pnpm --filter @frameboard/api dev"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "[email protected]"
}
