# /apps/api/.env.example

# Copy this file and rename based on environment:
# - Local development:  .env.local
# - Development build:  .env.development
# - Production build:   .env.production

# Application
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=replace-with-openssl-rand-hex-32

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://frameboard:frameboard@localhost:5432/frameboard

# Auth
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# NextAuth integration. NEXTAUTH_SECRET must match the frontend's
# NEXTAUTH_SECRET so HS256 JWT verification works. AUTH_DISABLED=1
# skips JWT verification entirely and treats every request as
# DEV_USER_EMAIL — convenient for local dev / self-host without OAuth.
# Production deployments must leave AUTH_DISABLED unset (or set to 0).
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_DISABLED=0
DEV_USER_EMAIL=dev@frameboard.local
