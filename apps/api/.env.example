# /apps/api/.env.example
#
# Copy to `.env.local` and edit for your machine. The defaults below
# get a local stack running without registering an OAuth app — flip
# the AUTH_DISABLED + NEXTAUTH_SECRET lines for a public deployment.

# ── Application ────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=replace-with-openssl-rand-hex-32

# ── Server ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
# Comma-separated list of origins allowed to call this API. Add your
# Cloudflare Pages domain (and any preview deployments) in production.
API_CORS_ORIGINS=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────
# Port 5433 matches docker-compose.yml in the repo root, which maps
# the Postgres container off the standard 5432 so it doesn't collide
# with a host install.
DATABASE_URL=postgresql+psycopg://frameboard:frameboard@localhost:5433/frameboard

# ── Legacy JWT settings ────────────────────────────────────────────
# Declared on the settings model and read by tests; the real session
# signing key is NEXTAUTH_SECRET below. Safe to leave as placeholders
# unless you build a separate API token system.
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── NextAuth integration ───────────────────────────────────────────
# NEXTAUTH_SECRET must match the frontend's NEXTAUTH_SECRET so HS256
# JWT verification works on both sides. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# AUTH_DISABLED=1 skips JWT verification entirely and treats every
# request as DEV_USER_EMAIL — convenient for local dev / self-host
# without OAuth. Production deployments must set AUTH_DISABLED=0 (or
# leave the variable unset) so unauthenticated requests are rejected.
AUTH_DISABLED=1
DEV_USER_EMAIL=dev@frameboard.local
