# /apps/web/.env.example

# Copy this file and rename based on environment:
# - Local development:  .env.development.local
# - Development build:  .env.development
# - Production build:   .env.production

# Backend API endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# OAuth providers (optional for MVP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Feature flags
NEXT_PUBLIC_ENABLE_EXPORT_JIRA=false
NEXT_PUBLIC_ENABLE_EXPORT_LINEAR=false
