# /apps/web/.env.example

# Copy this file and rename based on environment:
# - Local development:  .env.development.local
# - Development build:  .env.development
# - Production build:   .env.production

# Backend API endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── NextAuth ────────────────────────────────────────────────────────
# Required for any environment that runs the auth-aware middleware /
# session encoding, even local dev with the disabled-auth bypass. In
# production must be a long random string shared with the FastAPI
# backend's NEXTAUTH_SECRET env var (HS256 JWT signing key).
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
# Required only in production — Next.js falls back to localhost in dev.
# NEXTAUTH_URL=https://frameboard.example.com

# Skip the sign-in flow entirely. Set to "1" for local dev / self-host
# so contributors don't have to register an OAuth app. Pair with the
# backend's AUTH_DISABLED=1.
NEXT_PUBLIC_AUTH_DISABLED=0

# ── GitHub OAuth (required when NEXT_PUBLIC_AUTH_DISABLED is not set) ─
# Register an OAuth app at https://github.com/settings/developers with
# the callback set to {NEXTAUTH_URL}/api/auth/callback/github.
GITHUB_ID=
GITHUB_SECRET=

# ── Feature flags (work-in-progress) ─────────────────────────────────
NEXT_PUBLIC_ENABLE_EXPORT_JIRA=false
NEXT_PUBLIC_ENABLE_EXPORT_LINEAR=false
