# /apps/web/.env.example
#
# Copy to `.env.development.local` and edit for your machine. The
# defaults below get the frontend running against a local backend
# without registering a GitHub OAuth app — flip the auth lines for
# a public deployment.

# ── Backend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# ── NextAuth ───────────────────────────────────────────────────────
# Required even with the disabled-auth bypass — auth.ts imports throw
# at load time without a value. Generate a real one for production:
#   openssl rand -base64 32
# Must match the backend's NEXTAUTH_SECRET so HS256 JWT verification
# works across both halves of the stack.
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Production only. Next.js infers this from the request in dev, so
# leave it commented unless you're deploying.
# NEXTAUTH_URL=https://frameboard.example.com

# Skip the sign-in flow entirely. "1" for local dev / self-host;
# unset (or "0") for production. Pair with the backend's
# AUTH_DISABLED=1 — both halves must agree.
NEXT_PUBLIC_AUTH_DISABLED=1

# ── GitHub OAuth ───────────────────────────────────────────────────
# Required only when NEXT_PUBLIC_AUTH_DISABLED is unset/0. Register
# an OAuth app at https://github.com/settings/developers with the
# callback set to:
#   {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ── Feature flags ──────────────────────────────────────────────────
# Reserved for roadmap items — not consumed by any current code path.
# Safe to leave unset.
NEXT_PUBLIC_ENABLE_EXPORT_JIRA=false
NEXT_PUBLIC_ENABLE_EXPORT_LINEAR=false
