# /apps/web/.env.production
#
# Loaded automatically by `next build` (and therefore by
# `next-on-pages`). The values here are inlined into the client bundle
# at build time, so they must be safe to ship publicly — which
# `NEXT_PUBLIC_*` already guarantees.
#
# Server-side runtime env vars (NEXTAUTH_SECRET, GITHUB_ID, etc.) are
# NOT set here — those live on the Cloudflare Pages dashboard so
# they're never committed to the repo.

NEXT_PUBLIC_API_BASE_URL=https://frameboard-api.onrender.com
