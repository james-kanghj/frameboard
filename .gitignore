# /.gitignore

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Turbo
.turbo/

# Coverage
coverage/
.nyc_output/

# Database
*.db
*.sqlite
*.sqlite3
